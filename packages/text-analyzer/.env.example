# Used only by the Vite development proxy. This variable is intentionally
# not VITE_-prefixed, so it is never exposed to browser JavaScript.
FLAXIA_API_KEY=replace-with-the-same-local-development-key-as-worker

# Coordinator origin for the opt-in volunteer node's signaling socket.
# Production builds must set this to the reviewed HTTPS coordinator origin.
VITE_FLAXIA_ORCHESTRATOR_URL=http://localhost:8787

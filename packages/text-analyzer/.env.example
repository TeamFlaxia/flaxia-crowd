# Used only by the Vite development proxy. This variable is intentionally
# not VITE_-prefixed, so it is never exposed to browser JavaScript.
FLAXIA_API_KEY=replace-with-the-same-local-development-key-as-worker

# Orchestrator origin baked into the bundle (node signaling + demo UI).
# Empty by default: an unconfigured build shows a configuration error instead
# of silently pointing at production infrastructure.
VITE_ORCHESTRATOR_URL=

# Comma-separated allowlist of origins that may override the orchestrator
# through localStorage["flaxia_orchestrator_url"]. Empty by default, which
# ignores every stored override. Only list origins you operate, e.g.
# http://localhost:8787
VITE_ALLOWED_ORCHESTRATOR_ORIGINS=
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "paths": {
      "@flaxia/sdk": [
        "../sdk/src/index.ts"
      ]
    },
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "swarm/**/*.ts"
  ]
}
